{
  "name": "@pawanhirumina/ai-faq",
  "version": "1.0.5",
  "description": "An interactive FAQ accordion component featuring an integrated AI query box.",
  "type": "module",
  "main": "./dist/ai-faq.umd.cjs",
  "module": "./dist/ai-faq.js",
  "bin": {
    "ai-faq": "bin/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/ai-faq.js",
      "require": "./dist/ai-faq.umd.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "src/ts-tw",
    "src/js-tw",
    "src/ts-css",
    "src/js-css"
  ],
  "homepage": "https://github.com/pawanhirumina/ai-faq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawanhirumina/ai-faq.git"
  },
  "bugs": {
    "url": "https://github.com/pawanhirumina/ai-faq/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0 || ^12.0.0 || ^13.0.0 || ^14.0.0",
    "lucide-react": "^0.300.0 || ^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.19",
    "vite-plugin-dts": "^4.3.0"
  },
  "scripts": {
    "build": "vite build"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
