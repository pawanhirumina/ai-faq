{
  "name": "@pawanhirumina/ai-faq",
  "version": "1.0.7",
  "description": "An interactive FAQ accordion component featuring an integrated AI query box.",
  "type": "module",
  "main": "./dist/ai-faq.umd.cjs",
  "module": "./dist/ai-faq.js",
  "bin": {
    "ai-faq": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/ai-faq.js",
      "require": "./dist/ai-faq.umd.cjs"
    }
  },
  "files": [
	  "dist",
	  "bin",
	  "src"
  ],
  "homepage": "https://github.com/pawanhirumina/ai-faq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawanhirumina/ai-faq.git"
  },
  "bugs": {
    "url": "https://github.com/pawanhirumina/ai-faq/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "peerDependencies": {
    "framer-motion": ">=11",
    "lucide-react": ">=0.300.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.19",
    "vite-plugin-dts": "^4.3.0"
  },
  "scripts": {
    "build": "vite build"
  }
}
